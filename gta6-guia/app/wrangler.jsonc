{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vice-detonado",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",

  // Domínio do app (mesmo esquema do Prato Tranquilo). O domínio vicedetonado.com precisa estar na sua conta Cloudflare.
  "routes": [{ "pattern": "app.vicedetonado.com", "custom_domain": true }],

  // O Worker responde /api/*; o resto (o app) vem de ./public.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vice-detonado",
      // Preencha com o id que o `npx wrangler d1 create vice-detonado` mostrar.
      "database_id": "e89e7d6d-d91e-40cb-9e4b-bbffe8cf0ecc",
      "migrations_dir": "migrations"
    }
  ],

  // Variáveis não secretas. Segredo opcional: `npx wrangler secret put SELLYO_WEBHOOK_TOKEN`.
  "vars": {
    "APP_ENV": "production",
    // Senha inicial de quem compra (informe no e-mail de entrega da Sellyo).
    "DEFAULT_PASSWORD": "12345678",
    // Limite de aparelhos por conta (entrar num novo derruba o mais antigo) e de logins por 24h.
    "MAX_DEVICES": "2",
    "MAX_LOGINS_DAY": "5",
    // Links de checkout mostrados nos módulos trancados (opcional).
    "CHECKOUT_URL": "",
    "BUMP_URL_DINHEIRO": "https://pay.sellyo.com.br/p/hiexk9vxgg5",
    "BUMP_URL_PLATINA": "https://pay.sellyo.com.br/p/7h851xt12js",
    "BUMP_URL_GARAGEM": "https://pay.sellyo.com.br/p/a6a5xyxyxp1",
    // E-mails (Resend). A chave é segredo: `npx wrangler secret put RESEND_API_KEY`.
    // O domínio do remetente precisa estar verificado em resend.com/domains.
    "APP_URL": "https://app.vicedetonado.com",
    "EMAIL_FROM": "Vice Detonado <acesso@vicedetonado.com>",
    // Para onde vão as respostas dos clientes (vazio = sem "responda este e-mail").
    "EMAIL_REPLY_TO": ""
  }
}
